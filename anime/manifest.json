{
  "manifest_version": 3,
  "name": "Kaze Anime",
  "version": "2.3.0",
  "description": "Anime downloads that show you what you are getting first. Search, pick episodes, see the real quality and size, save anywhere. Runs entirely in your browser.",
  "permissions": [
    "tabs",
    "storage",
    "downloads",
    "declarativeNetRequest",
    "webRequest",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "https://animepahe.pw/*",
    "https://*.animepahe.pw/*",
    "https://animepahe.com/*",
    "https://*.animepahe.com/*",
    "https://animepahe.org/*",
    "https://*.animepahe.org/*",
    "https://pahe.win/*",
    "https://kwik.cx/*",
    "https://animeheaven.me/*",
    "https://*.animeheaven.me/*",
    "https://challenges.cloudflare.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Kaze Anime"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
