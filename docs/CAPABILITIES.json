{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kaze capability document",
  "type": "object",
  "required": ["module", "provider", "protocol", "capabilities"],
  "properties": {
    "module": {
      "type": "string",
      "enum": ["showcase", "anime", "video"]
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "type": "integer",
      "minimum": 1
    },
    "version": {
      "type": "string"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    }
  },
  "additionalProperties": false
}
